RewriteEngine On

# --- Könyvtárlistázás tiltása ---
Options -Indexes

# --- HTTP -> HTTPS átirányítás ---
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- Biztonsági fejlécek ---
<IfModule mod_headers.c>
  # HSTS: 1 év (csak akkor élesítsd preload-dal, ha minden aldomain HTTPS-es)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Content-Security-Policy — élesítés után teszteld a /etlap oldalt (Adobe PDF viewer),
  # és csak utána kapcsold be a lenti sort (a viewer több *.adobe.com aldomaint használ):
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://documentservices.adobe.com https://*.adobe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.adobe.com; font-src 'self' data:; connect-src 'self' https://*.adobe.com https://*.adobe.io; frame-src https://www.google.com https://*.adobe.com blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- Saját 404 oldal ---
ErrorDocument 404 /404.html

# --- Főoldal nyelvi változatai (ugyanaz az index.html, a nyelvet az URL adja) ---
RewriteRule ^en/?$           index.html [L]
RewriteRule ^de/?$           index.html [L]

# --- Dokumentum útvonalak (a JS az útvonalból ismeri fel, melyik PDF + nyelv) ---
RewriteRule ^etlap/?$        dokumentum.html [L]
RewriteRule ^menu/?$         dokumentum.html [L]
RewriteRule ^aszf/?$         dokumentum.html [L]
RewriteRule ^terms/?$        dokumentum.html [L]
RewriteRule ^agb/?$          dokumentum.html [L]
RewriteRule ^adatkezeles/?$  dokumentum.html [L]
RewriteRule ^privacy/?$      dokumentum.html [L]
RewriteRule ^datenschutz/?$  dokumentum.html [L]

# --- /index(.html) -> / ---
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# --- .html eltüntetése a címsorból ---
# 1) /oldal.html -> /oldal  (külső 301 átirányítás)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
# 2) /oldal -> /oldal.html  (belül kiszolgálja, ha létezik a .html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --- Böngésző-cache statikus fájlokra ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 6 months"
  ExpiresByType image/png   "access plus 6 months"
  ExpiresByType image/webp  "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2  "access plus 1 year"
  ExpiresByType text/css    "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType text/html   "access plus 0 seconds"
</IfModule>

# --- Tömörítés (ha a szerver nem kezeli automatikusan) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
