RewriteEngine On

# --- Főoldal nyelvi változatai (ugyanaz az index.html, a nyelvet az URL adja) ---
RewriteRule ^en/?$           index.html [L]
RewriteRule ^de/?$           index.html [L]

# --- Dokumentum útvonalak (a JS az útvonalból ismeri fel, melyik PDF + nyelv) ---
RewriteRule ^etlap/?$        dokumentum.html [L]
RewriteRule ^menu/?$         dokumentum.html [L]
RewriteRule ^aszf/?$         dokumentum.html [L]
RewriteRule ^terms/?$        dokumentum.html [L]
RewriteRule ^agb/?$          dokumentum.html [L]
RewriteRule ^adatkezeles/?$  dokumentum.html [L]
RewriteRule ^privacy/?$      dokumentum.html [L]
RewriteRule ^datenschutz/?$  dokumentum.html [L]

# --- /index(.html) -> / ---
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# --- .html eltüntetése a címsorból ---
# 1) /oldal.html -> /oldal  (külső 301 átirányítás)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
# 2) /oldal -> /oldal.html  (belül kiszolgálja, ha létezik a .html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
